[user]
	name = Jason Zhang
	email = jason.zhang@lexisnexis.com
[core]
	editor = code --wait
	autocrlf = input
[color]
	ui = true
[merge]
	tool = vscode
[diff]
	tool = vscode
[init]
	defaultBranch = main
[push]
	default = simple
[credential]
	helper = !aws codecommit credential-helper $@
[http]
	sslbackend = openssl
	sslVerify = true
